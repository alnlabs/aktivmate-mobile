{
  "expo": {
    "name": "AktivMate",
    "slug": "aktivmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aktivmate",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f0fcf6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alnlabs.aktivmate",
      "appleTeamId": "GQ5YBDCV3L",
      "infoPlist": {
        "NSMotionUsageDescription": "AktivMate counts your steps so your club total stays current.",
        "NSCameraUsageDescription": "AktivMate uses the camera for your profile photo.",
        "NSPhotoLibraryUsageDescription": "AktivMate uses a photo from your library for your profile picture.",
        "NSLocationWhenInUseUsageDescription": "AktivMate uses your location to set your city and show your walking path."
      }
    },
    "android": {
      "package": "com.alnlabs.aktivmate",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f0fcf6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f0fcf6",
          "imageWidth": 140
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "AktivMate counts your steps so your club total stays current."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AktivMate uses a photo from your library for your profile picture.",
          "cameraPermission": "AktivMate uses the camera for your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AktivMate uses your location to set your city and show your walking path."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/0f027b8e-3375-4a30-8178-3fde10619d3a"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0f027b8e-3375-4a30-8178-3fde10619d3a"
      }
    },
    "owner": "nageshwar521"
  }
}
